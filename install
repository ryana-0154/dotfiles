#!/usr/bin/env bash
#
# Bootstrap: install chezmoi if missing, init it against this repo, and apply.
#
# Usage:
#   ./install               # apply this checkout
#   ./install --dry-run     # show what chezmoi would do
#
# After bootstrap, manage dotfiles with chezmoi directly:
#   chezmoi edit ~/.bashrc
#   chezmoi diff
#   chezmoi apply
#   chezmoi update            # git pull + apply

set -euo pipefail

REPO_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

ensure_chezmoi() {
	if command -v chezmoi >/dev/null 2>&1; then
		return
	fi
	echo "chezmoi not found — installing to ~/.local/bin"
	mkdir -p "$HOME/.local/bin"
	sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
	export PATH="$HOME/.local/bin:$PATH"
}

ensure_submodules() {
	[[ -f "$REPO_DIR/.gitmodules" ]] || return 0
	git -C "$REPO_DIR" submodule update --init --recursive
}

ensure_chezmoi
ensure_submodules

# Point chezmoi at this checkout. --source overrides the default
# ~/.local/share/chezmoi so the working tree stays where you cloned it.
chezmoi init --source="$REPO_DIR" "$@"
chezmoi apply --source="$REPO_DIR" "$@"

cat <<'EOF'

Done. Useful follow-ups:
  chezmoi diff             # preview pending changes
  chezmoi apply            # apply changes
  chezmoi edit ~/.bashrc   # edit the source file
  install-optional         # optional packages (if installed via extra_bins)
EOF
