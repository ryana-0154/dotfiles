#!/usr/bin/env bash

# If not running interactively, do nothing
[[ -n $PS1 ]] || return

# Source the exports file
. $HOME/.bash_exports

# Shell Options
shopt -s cdspell
shopt -s checkwinsize
shopt -s extglob
shopt -s histappend     # append to history, don't overwrite (multi-shell safe)

# Bash Version >= 4
shopt -s autocd 2>/dev/null || true
shopt -s dirspell 2>/dev/null || true
shopt -s globstar 2>/dev/null || true   # ** matches recursively

# History
HISTTIMEFORMAT='%F %T '
HISTIGNORE='ls:ll:la:cd:pwd:exit:clear:c:h:history:bg:fg:jobs'

# Prompt
# Store `tput` colors for future use to reduce fork+exec
# the array will be 0-255 for colors, 256 will be sgr0
# and 257 will be bold
COLOR256=()
COLOR256[0]=$(tput setaf 1)
COLOR256[256]=$(tput sgr0)
COLOR256[257]=$(tput bold)

# Colors for use in PS1 that may or may not change when
# set_prompt_colors is run
PROMPT_COLORS=()

# Construct the prompt
# [(exit code)] <user> - <hostname> <uname> <cwd> [git branch] <$|#>

# exit code of last process
# shellcheck disable=SC2154
PS1='$(ret=$?;(($ret!=0)) && echo "\[${COLOR256[0]}\]($ret) \[${COLOR256[256]}\]")'

# username (red for root)
PS1+='\[${PROMPT_COLORS[0]}\]\[${COLOR256[257]}\]$(((UID==0)) && echo "\[${COLOR256[0]}\]")\u\[${COLOR256[256]}\] - '

# zonename (global zone warning)
PS1+='\[${COLOR256[0]}\]\[${COLOR256[257]}\]'"$(zonename 2>/dev/null | grep -q '^global$' && echo 'GZ:')"'\[${COLOR256[256]}\]'

# hostname
PS1+='\[${PROMPT_COLORS[3]}\]\h '

# uname
PS1+='\[${PROMPT_COLORS[2]}\]'"$(uname | tr '[:upper:]' '[:lower:]')"' '

# cwd
PS1+='\[${PROMPT_COLORS[5]}\]\w '

# optional git branch
# shellcheck disable=SC2154
PS1+='$(branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); [[ -n $branch ]] && echo "\[${PROMPT_COLORS[2]}\](\[${PROMPT_COLORS[3]}\]git:$branch\[${PROMPT_COLORS[2]}\]) ")'

# prompt character
PS1+='\[${PROMPT_COLORS[0]}\]\$\[${COLOR256[256]}\] '

# Load external files
. $HOME/.bash_functions 2>/dev/null || true
. $HOME/.bash_aliases 2>/dev/null || true

# load completion
. /etc/bash/bash_completion 2>/dev/null ||
	. $HOME/.bash_completion 2>/dev/null
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

# set the theme
set_prompt_colors 24

# Prompt command
PROMPT_COMMAND=_prompt_command

PROMPT_DIRTRIM=6

path_add "$HOME/extra_bins" before
path_add "$HOME/.local/share/pnpm" after
path_add "/usr/local/go/bin" after

# WSL-only: surface the Windows-side VS Code CLI if present
if [[ -d "/mnt/c/Users/User/AppData/Local/Programs/Microsoft VS Code/bin" ]]; then
	path_add "/mnt/c/Users/User/AppData/Local/Programs/Microsoft VS Code/bin" before
fi

path_clean

# Node/npm isolation: only override when nvm is active
unset NPM_CONFIG_PREFIX NPM_CONFIG_CACHE NODE_PATH
export NPM_CONFIG_CACHE="$HOME/.npm"
if command -v node >/dev/null 2>&1 && [[ -d "$HOME/.nvm/versions/node/$(node -v 2>/dev/null)" ]]; then
	export NPM_CONFIG_PREFIX="$HOME/.nvm/versions/node/$(node -v)/"
fi
hash -r
alias npm='command npm --no-audit --no-fund'
alias npx='command npx --no-install'

. "$HOME/.local/bin/env" 2>/dev/null || true
path_add "$HOME/.local/bin" before
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export VOLTA_HOME="$HOME/.volta"
[[ -d "$VOLTA_HOME/bin" ]] && path_add "$VOLTA_HOME/bin" before

# Optional integrations — guard each so the file works on any host
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv bash)"
fi
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# fzf — Ctrl-R history, Ctrl-T file picker, ** completion
if command -v fzf >/dev/null 2>&1; then
	# bash 4.4+: prefer the modern --bash hook when available
	if fzf --bash >/dev/null 2>&1; then
		eval "$(fzf --bash)"
	else
		for f in \
			/usr/share/doc/fzf/examples/key-bindings.bash \
			/usr/share/fzf/key-bindings.bash \
			"$HOME/.fzf/shell/key-bindings.bash"; do
			[ -f "$f" ] && . "$f" && break
		done
		for f in \
			/usr/share/doc/fzf/examples/completion.bash \
			/usr/share/fzf/completion.bash \
			"$HOME/.fzf/shell/completion.bash"; do
			[ -f "$f" ] && . "$f" && break
		done
	fi
fi

# Per-host overrides not tracked in this repo
. $HOME/.bashrc.local 2>/dev/null || true

true
source <(kubectl completion bash)
alias k=kubectl
complete -o default -F __start_kubectl k
