#!/usr/bin/env bash
#
# Remove symlinks created by ./install. Only deletes a target if it's a
# symlink that points back into this repo — never touches real user files.
#
# Author: Ryan A
# License: MIT

set -euo pipefail

readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly RED='\033[0;31m'
readonly NC='\033[0m'

REPO=$PWD
removed=0
skipped=0

# True if $1 is a symlink whose target is somewhere under $REPO.
is_repo_symlink() {
	local link=$1 dest
	[[ -L $link ]] || return 1
	dest=$(readlink -f -- "$link" 2>/dev/null) || return 1
	[[ $dest == "$REPO"* ]]
}

unlink_one() {
	local target=$1
	if [[ ! -e $target && ! -L $target ]]; then
		return 0
	fi
	if is_repo_symlink "$target"; then
		printf '  %bremove%b %s\n' "$GREEN" "$NC" "${target/#$HOME/\~}"
		rm -- "$target"
		removed=$((removed + 1))
	else
		printf '  %bskip  %b %s (not a symlink into this repo)\n' \
			"$YELLOW" "$NC" "${target/#$HOME/\~}"
		skipped=$((skipped + 1))
	fi
}

# Mirror install's per-file-symlink folders.
unlink_folder_files() {
	local folder=$1 file name
	for file in "$folder"/*; do
		[[ -f $file ]] || continue
		name=$(basename -- "$file")
		unlink_one "$HOME/.$name"
	done
}

dotfile_folders=(
	bash git tmux curl wget misc htop shell
)

# Per-file symlinks (one ~/.<name> per file in the folder).
for folder in "${dotfile_folders[@]}"; do
	[[ -d $folder ]] || continue
	echo "==> $folder"
	unlink_folder_files "$folder"
done

# Whole-folder symlinks.
echo "==> claude / ssh / extra_bins / vim"
unlink_one "$HOME/.claude"
unlink_one "$HOME/.ssh"
unlink_one "$HOME/extra_bins"
unlink_one "$HOME/.vim"
# vim also has per-file dotfiles outside vim_folder
[[ -d vim ]] && unlink_folder_files "vim"

echo
printf '%bRemoved%b: %d   %bSkipped%b: %d\n' \
	"$GREEN" "$NC" "$removed" "$YELLOW" "$NC" "$skipped"

if (( skipped > 0 )); then
	cat <<-EOF

	Skipped entries are real files (or unrelated symlinks) — left in place
	on purpose. Inspect and remove them yourself if you actually want to.
	EOF
fi
